@model ActivityVm @{ViewData["Title"]="Log Activity";}<div class="panel"><form method="post"><div asp-validation-summary="All" class="validation"></div><div class="form-grid"><div class="field"><label>Type</label><select class="select" asp-for="ActivityType" asp-items="Html.GetEnumSelectList<ActivityType>()"></select></div><div class="field"><label>Date</label><input class="input" asp-for="ActivityDate" type="datetime-local"></div><div class="field full"><label>Subject</label><input class="input" asp-for="Subject"></div><div class="field"><label>Customer ID</label><input class="input" asp-for="CustomerId"></div><div class="field"><label>Lead ID</label><input class="input" asp-for="LeadId"></div><div class="field"><label>Status</label><select class="select" asp-for="Status" asp-items="Html.GetEnumSelectList<ActivityStatus>()"></select></div><div class="field full"><label>Description</label><textarea class="input" asp-for="Description"></textarea></div></div><div class="actions"><button class="btn">Log activity</button><a class="btn secondary" href="/Activities">Cancel</a></div></form></div>