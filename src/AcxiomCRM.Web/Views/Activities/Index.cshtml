@model IEnumerable<Activity> @{ViewData["Title"]="Activities";}<div class="toolbar"><div class="muted">Calls, meetings, emails and tasks.</div><a class="btn" href="/Activities/Create">+ Activity</a></div><div class="panel table-wrap"><table class="table"><thead><tr><th>Date</th><th>Type</th><th>Subject</th><th>Related</th><th>Status</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.ActivityDate.ToString("dd MMM yyyy HH:mm")</td><td>@a.ActivityType</td><td>@a.Subject</td><td>@(a.Customer?.CustomerName ?? a.Lead?.LeadName ?? "-")</td><td>@a.Status</td></tr>}</tbody></table></div>