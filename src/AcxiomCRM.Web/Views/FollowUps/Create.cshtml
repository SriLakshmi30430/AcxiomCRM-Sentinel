@model FollowUpVm @{ViewData["Title"]="Schedule Follow-up";}<div class="panel"><form method="post"><div asp-validation-summary="All" class="validation"></div><div class="form-grid"><div class="field"><label>Date</label><input class="input" asp-for="FollowUpDate" type="datetime-local"></div><div class="field"><label>Type</label><select class="select" asp-for="FollowUpType" asp-items="Html.GetEnumSelectList<FollowUpType>()"></select></div><div class="field full"><label>Subject</label><input class="input" asp-for="Subject"></div><div class="field"><label>Customer ID</label><input class="input" asp-for="CustomerId"></div><div class="field"><label>Lead ID</label><input class="input" asp-for="LeadId"></div><div class="field"><label>Opportunity ID</label><input class="input" asp-for="OpportunityId"></div><div class="field full"><label>Remarks</label><textarea class="input" asp-for="Remarks"></textarea></div></div><div class="actions"><button class="btn">Schedule</button><a class="btn secondary" href="/FollowUps">Cancel</a></div></form></div>