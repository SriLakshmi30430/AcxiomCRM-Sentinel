@model IEnumerable<FollowUp> @{ViewData["Title"]="Follow-ups";}<div class="toolbar"><div class="muted">Plan, complete and recover missed customer touchpoints.</div><a class="btn" href="/FollowUps/Create">+ Follow-up</a></div><div class="panel table-wrap"><table class="table"><thead><tr><th>Date</th><th>Subject</th><th>Type</th><th>Related</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var f in Model){<tr><td>@f.FollowUpDate.ToString("dd MMM yyyy HH:mm")</td><td>@f.Subject</td><td>@f.FollowUpType</td><td>@(f.Customer?.CustomerName ?? f.Opportunity?.OpportunityName ?? "Lead")</td><td><span class="badge @(f.Status==FollowUpStatus.Missed?"risk-high":f.Status==FollowUpStatus.Completed?"risk-low":"")">@f.Status</span></td><td>@if(f.Status==FollowUpStatus.Planned){<form method="post" action="/FollowUps/Complete" style="display:inline"><input type="hidden" name="id" value="@f.Id"><input type="hidden" name="status" value="Completed"><button class="btn" type="submit">Complete</button></form>}</td></tr>}</tbody></table></div>