@model DashboardVm @{ViewData["Title"]="Command Center";}<div class="grid cards"><div class="card"><div class="kpi-label">TOTAL CUSTOMERS</div><div class="kpi">@Model.Customers</div></div><div class="card"><div class="kpi-label">OPEN LEADS</div><div class="kpi">@Model.OpenLeads</div></div><div class="card"><div class="kpi-label">OPEN OPPORTUNITIES</div><div class="kpi">@Model.Opportunities</div></div><div class="card"><div class="kpi-label">WEIGHTED PIPELINE</div><div class="kpi">₹@Model.Pipeline.ToString("N0")</div></div></div><div class="grid two"><div class="panel"><h2>Lead health</h2><div class="chartbox"><canvas id="leadChart"></canvas></div></div><div class="panel"><h2>Opportunity pipeline</h2><div class="chartbox"><canvas id="pipeChart"></canvas></div></div></div><div class="panel" style="margin-top:20px"><div class="split"><h2>Sales Intelligence Watchlist</h2><span class="badge risk-high">Explainable risk</span></div><div class="table-wrap"><table class="table"><thead><tr><th>Opportunity</th><th>Customer</th><th>Amount</th><th>Probability</th><th>Action</th></tr></thead><tbody>@foreach(var o in Model.Risky){<tr><td>@o.OpportunityName</td><td>@o.Customer?.CustomerName</td><td>₹@o.Amount.ToString("N0")</td><td>@o.Probability%</td><td><form method="post" action="/Opportunities/Analyze"><input type="hidden" name="id" value="@o.Id"><button class="btn secondary" type="submit">Analyze risk</button></form></td></tr>}</tbody></table></div></div>@section Scripts{<script>new Chart(document.getElementById('leadChart'),{type:'doughnut',data:{labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatus.Keys)),datasets:[{data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatus.Values))}]},options:{maintainAspectRatio:false}});new Chart(document.getElementById('pipeChart'),{type:'bar',data:{labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineByStage.Keys)),datasets:[{label:'Pipeline',data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineByStage.Values))}]},options:{maintainAspectRatio:false}});</script>}