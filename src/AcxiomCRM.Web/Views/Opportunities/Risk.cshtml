@model OpportunityRiskScore
@{ViewData["Title"]="Opportunity Risk Intelligence"; var factors=System.Text.Json.JsonSerializer.Deserialize<List<RiskFactor>>(Model.FactorsJson) ?? new(); var recs=System.Text.Json.JsonSerializer.Deserialize<List<string>>(Model.RecommendationsJson) ?? new();}
<div class="grid two"><div class="panel"><div class="eyebrow">EXPLAINABLE SALES INTELLIGENCE</div><h2>@ViewBag.Opportunity.OpportunityName</h2><div class="kpi">@Model.RiskScore/100</div><p><span class="badge @(Model.RiskLevel=="HIGH"||Model.RiskLevel=="CRITICAL"?"risk-high":Model.RiskLevel=="MEDIUM"?"risk-medium":"risk-low")">@Model.RiskLevel RISK</span></p><p class="muted">Predicted win probability: <strong>@Model.PredictedWinProbability%</strong></p></div><div class="panel"><h2>Recommended actions</h2><ol>@foreach(var r in recs){<li style="margin:10px 0">@r</li>}</ol></div></div>
<div class="panel" style="margin-top:20px"><h2>Why the model reached this result</h2><div class="table-wrap"><table class="table"><thead><tr><th>Factor</th><th>Impact</th><th>Severity</th></tr></thead><tbody>@foreach(var f in factors){<tr><td>@f.factor</td><td>@f.impact</td><td>@f.severity</td></tr>}</tbody></table></div></div>
<div class="actions"><a class="btn" href="/Opportunities">Back to opportunities</a><a class="btn secondary" href="/Dashboard">Dashboard</a></div>
@functions { public class RiskFactor { public string factor{get;set;}=""; public double impact{get;set;} public string severity{get;set;}=""; } }
