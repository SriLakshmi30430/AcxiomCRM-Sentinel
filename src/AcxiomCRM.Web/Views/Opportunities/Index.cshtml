@model IEnumerable<Opportunity> @{ViewData["Title"]="Opportunities";}<div class="toolbar"><form method="get"><input class="input" name="q" placeholder="Search opportunity/customer"><button class="btn secondary">Search</button></form><a class="btn" href="/Opportunities/Create">+ Opportunity</a></div><div class="panel table-wrap"><table class="table"><thead><tr><th>Opportunity</th><th>Customer</th><th>Stage</th><th>Amount</th><th>Prob.</th><th>Weighted</th><th></th></tr></thead><tbody>@foreach(var o in Model){<tr><td><strong>@o.OpportunityName</strong><br><span class="muted">@o.Status</span></td><td>@o.Customer?.CustomerName</td><td>@o.Stage</td><td>₹@o.Amount.ToString("N0")</td><td>@o.Probability%</td><td>₹@o.WeightedValue.ToString("N0")</td><td><a class="btn secondary" href="/Opportunities/Edit/@o.Id">Edit</a> <form style="display:inline" method="post" action="/Opportunities/Analyze"><input type="hidden" name="id" value="@o.Id"><button class="btn" type="submit">Risk</button></form></td></tr>}</tbody></table></div>