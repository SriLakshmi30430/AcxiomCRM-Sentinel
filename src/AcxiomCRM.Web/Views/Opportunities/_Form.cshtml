@model OpportunityVm<div asp-validation-summary="All" class="validation"></div><div class="form-grid"><div class="field full"><label>Opportunity name</label><input class="input" asp-for="OpportunityName"></div><div class="field"><label>Customer ID</label><input class="input" asp-for="CustomerId"></div><div class="field"><label>Lead ID (optional)</label><input class="input" asp-for="LeadId"></div><div class="field"><label>Amount</label><input class="input" asp-for="Amount"></div><div class="field"><label>Probability (0-100)</label><input class="input" asp-for="Probability"></div><div class="field"><label>Stage</label><select class="select" asp-for="Stage" asp-items="Html.GetEnumSelectList<OpportunityStage>()"></select></div><div class="field"><label>Status</label><select class="select" asp-for="Status" asp-items="Html.GetEnumSelectList<OpportunityStatus>()"></select></div><div class="field"><label>Expected close date</label><input class="input" asp-for="ExpectedCloseDate" type="date"></div><div class="field full"><label>Notes</label><textarea class="input" asp-for="Notes"></textarea></div></div><div class="actions"><button class="btn">Save opportunity</button><a class="btn secondary" href="/Opportunities">Cancel</a></div>