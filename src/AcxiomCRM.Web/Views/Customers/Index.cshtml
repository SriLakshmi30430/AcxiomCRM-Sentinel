@model IEnumerable<Customer> @{ViewData["Title"]="Customers";}<div class="toolbar"><form method="get"><input class="input" name="q" placeholder="Search name, email, phone, company" value="@Context.Request.Query["q"]"><button class="btn secondary">Search</button></form><a class="btn" href="/Customers/Create">+ Customer</a></div><div class="panel table-wrap"><table class="table"><thead><tr><th>Customer</th><th>Company</th><th>Contact</th><th>Status</th><th>Owner</th><th></th></tr></thead><tbody>@foreach(var c in Model){<tr><td><strong>@c.CustomerName</strong><br><span class="muted">@c.CustomerCode</span></td><td>@c.CompanyName</td><td>@c.Email<br>@c.Phone</td><td><span class="badge">@c.Status</span></td><td>@c.Owner?.FullName</td><td><a class="btn secondary" href="/Customers/Details/@c.Id">View</a> <a class="btn secondary" href="/Customers/Edit/@c.Id">Edit</a><form style="display:inline" method="post" action="/Customers/Delete/@c.Id"><button class="btn danger" data-confirm="Deactivate this customer?">Deactivate</button></form></td></tr>}</tbody></table></div>