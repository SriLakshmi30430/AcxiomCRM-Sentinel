@model CustomerVm<div asp-validation-summary="All" class="validation"></div><div class="form-grid"><div class="field"><label>Name</label><input class="input" asp-for="CustomerName"><span asp-validation-for="CustomerName" class="validation"></span></div><div class="field"><label>Email</label><input class="input" asp-for="Email"><span asp-validation-for="Email" class="validation"></span></div><div class="field"><label>Phone</label><input class="input" asp-for="Phone"><span asp-validation-for="Phone" class="validation"></span></div><div class="field"><label>Company</label><input class="input" asp-for="CompanyName"></div><div class="field"><label>City</label><input class="input" asp-for="City"></div><div class="field"><label>State</label><input class="input" asp-for="State"></div><div class="field full"><label>Address</label><input class="input" asp-for="Address"></div><div class="field"><label>Status</label><select class="select" asp-for="Status" asp-items="Html.GetEnumSelectList<CustomerStatus>()"></select></div></div><div class="actions"><button class="btn" type="submit">Save customer</button><a class="btn secondary" href="/Customers">Cancel</a></div>