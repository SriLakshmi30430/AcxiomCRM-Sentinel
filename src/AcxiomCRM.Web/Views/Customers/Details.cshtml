@model Customer @{ViewData["Title"]="Customer Details";}<div class="grid two"><div class="panel"><h2>@Model.CustomerName</h2><p class="muted">@Model.CompanyName</p><p>@Model.Email<br>@Model.Phone<br>@Model.City, @Model.State</p><a class="btn" href="/Customers/Edit/@Model.Id">Edit</a></div><div class="panel"><h2>Pipeline</h2><p>@Model.Opportunities.Count opportunities</p><p>@Model.Leads.Count linked leads</p><p class="muted">Owner: @Model.Owner?.FullName</p></div></div>