@model IEnumerable<AuditLog> @{ViewData["Title"]="Audit Log";}<div class="panel table-wrap"><table class="table"><thead><tr><th>Time</th><th>Action</th><th>Entity</th><th>Record</th><th>User</th><th>Result</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</td><td>@x.Action</td><td>@x.EntityName</td><td>@x.RecordId</td><td>@x.UserId</td><td>@x.Result</td></tr>}</tbody></table></div>