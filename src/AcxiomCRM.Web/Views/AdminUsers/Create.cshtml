@model AdminUserVm @{ViewData["Title"]="Create User";}
<div class="panel"><form method="post"><div asp-validation-summary="All" class="validation"></div><div class="form-grid"><div class="field"><label>Full name</label><input class="input" asp-for="FullName"></div><div class="field"><label>Email</label><input class="input" asp-for="Email"></div><div class="field"><label>Temporary password</label><input class="input" asp-for="Password" type="password"></div><div class="field"><label>Primary role</label><select class="select" asp-for="Role"><option>Admin</option><option>Manager</option><option>SalesExecutive</option></select></div></div><div class="actions"><button class="btn">Create user</button><a class="btn secondary" href="/AdminUsers">Cancel</a></div></form></div>
