@model IEnumerable<Opportunity> @{ViewData["Title"]="Reports";}<div class="grid cards"><div class="card"><div class="kpi-label">TOTAL OPPORTUNITIES</div><div class="kpi">@Model.Count()</div></div><div class="card"><div class="kpi-label">TOTAL VALUE</div><div class="kpi">₹@Model.Sum(x=>x.Amount).ToString("N0")</div></div><div class="card"><div class="kpi-label">WEIGHTED PIPELINE</div><div class="kpi">₹@Model.Where(x=>x.Status==OpportunityStatus.Open).Sum(x=>x.WeightedValue).ToString("N0")</div></div><div class="card"><div class="kpi-label">LEAD CONVERSION</div><div class="kpi">@ViewBag.Conversion%</div></div></div><div class="panel" style="margin-top:20px"><div class="toolbar"><h2>Opportunity report</h2><a class="btn" href="/Reports/ExportOpportunities">Export CSV</a></div><div class="table-wrap"><table class="table"><thead><tr><th>Opportunity</th><th>Stage</th><th>Amount</th><th>Probability</th><th>Close date</th><th>Owner</th></tr></thead><tbody>@foreach(var o in Model){<tr><td>@o.OpportunityName<br><span class="muted">@o.Customer?.CustomerName</span></td><td>@o.Stage</td><td>₹@o.Amount.ToString("N0")</td><td>@o.Probability%</td><td>@o.ExpectedCloseDate.ToString("dd MMM yyyy")</td><td>@o.Owner?.FullName</td></tr>}</tbody></table></div></div>