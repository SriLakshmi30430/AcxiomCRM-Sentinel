<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] - AcxiomCRM Sentinel</title><link rel="stylesheet" href="~/css/site.css"><script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script></head><body><div class="app"><aside class="sidebar"><div class="brand">◈ <span>AcxiomCRM</span></div><div class="tag">SENTINEL</div><nav><a href="/Dashboard">Dashboard</a><a href="/Customers">Customers</a><a href="/Leads">Leads</a><a href="/Opportunities">Opportunities</a><a href="/FollowUps">Follow-ups</a><a href="/Activities">Activities</a>@if(User.IsInRole("Admin")||User.IsInRole("Manager")){<a href="/Reports">Reports</a><a href="/Audit">Audit</a>}@if(User.IsInRole("Admin")){<a href="/AdminUsers">Users</a>}</nav><div class="side-bottom">@if(User.Identity?.IsAuthenticated==true){<div class="user-mini">@User.Identity.Name</div><form method="post" action="/Account/Logout"><button class="linkbtn">Sign out</button></form>}</div></aside><main class="main"><header><div><div class="eyebrow">SALES OPERATIONS PLATFORM</div><h1>@ViewData["Title"]</h1></div><div class="top-user">@(User.Identity?.Name ?? "Guest")</div></header><section class="content">@if(TempData["Success"]!=null){<div class="alert success">@TempData["Success"]</div>}@RenderBody()</section></main></div><script src="~/js/site.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>