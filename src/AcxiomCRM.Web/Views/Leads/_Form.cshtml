@model LeadVm<div asp-validation-summary="All" class="validation"></div><div class="form-grid"><div class="field"><label>Name</label><input class="input" asp-for="LeadName"></div><div class="field"><label>Email</label><input class="input" asp-for="Email"></div><div class="field"><label>Phone</label><input class="input" asp-for="Phone"></div><div class="field"><label>Company</label><input class="input" asp-for="CompanyName"></div><div class="field"><label>Source</label><input class="input" asp-for="Source"></div><div class="field"><label>Expected value</label><input class="input" asp-for="ExpectedValue"></div><div class="field"><label>Status</label><select class="select" asp-for="Status" asp-items="Html.GetEnumSelectList<LeadStatus>()"></select></div><div class="field"><label>Priority</label><select class="select" asp-for="Priority" asp-items="Html.GetEnumSelectList<LeadPriority>()"></select></div></div><div class="actions"><button class="btn">Save lead</button><a class="btn secondary" href="/Leads">Cancel</a></div>